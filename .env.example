# Public attacompute.ai Seller Dashboard Configuration
# Copy to .env.local for local overrides. NEVER put secrets in VITE_* variables
# (everything prefixed with VITE_ is embedded in the client bundle).

# Base URL path for static asset deployment.
# Use "/" for standalone deployment (routes live at /dashboard, /dashboard/pricing, /dashboard/live).
# Use "/dashboard/" when mounting the built assets under a subpath of a separate root website.
VITE_BASE_PATH=/

# Public AntSeedStats API base URL (open CORS, ~300s cache)
VITE_ANTSEEDSTATS_API_BASE=https://antseedstats.com/api/v1

# Public seller identity (safe on-chain values)
VITE_SELLER_ADDRESS=0x6C8044f5E6fb2aD70dD31FD7A20FAE05A73FA139
VITE_SELLER_NAME=attacompute.ai
VITE_AGENT_ID=47214
# Comma-separated other public wallets of ours (e.g. a retired seller wallet). Shown as "Your listing",
# never counted as a fallback peer or competitor.
VITE_OWN_ADDRESSES=0xD5E7d5950B6CC71c095DA4ACE0C0CB8495667be0

# Price-change request GitHub issue target (opened under the operator's own GitHub login)
VITE_PRICE_CHANGE_REPO=attacompute/node
VITE_PRICE_CHANGE_LABEL=price-change

# Optional: deploy-time webhook endpoint for Submit-for-change POST requests.
# Leave empty to disable (default). If enabled, protect this endpoint with Cloudflare Access.
VITE_PRICE_CHANGE_WEBHOOK_URL=

# Optional: browser-accessible proxy URL for the seller's public /metadata JSON
# (for example "/api/seller-metadata" when using the included Cloudflare Pages Function).
# Leave empty to skip metadata enrichment gracefully.
VITE_SELLER_METADATA_PROXY_URL=

# Server-side Cloudflare Pages Function environment variable (NOT exposed to the browser):
# Set SELLER_METADATA_URL in Cloudflare Pages project settings if enabling functions/api/seller-metadata.ts
# Example placeholder (never commit real hostnames or IPs):
# SELLER_METADATA_URL=http://seller-metadata.example.invalid/metadata
